/-- Each shared rational table item is recomputed by kernel reduction. -/
theorem k10_gamma_entries_checked : ∀ i : Fin 79,
    0 < (k10GammaEntry i).radius ∧ (k10GammaEntry i).radius ≤ 9 / 4 ∧
    scalarAngleCheck (3521357 / 1000000) (k10GammaEntry i).radius
      (k10GammaEntry i).units 100000 = true := by
  decide +kernel

theorem k10_pair_entries_checked : ∀ i : Fin 736,
    123 / 100 ≤ (k10PairEntry i).first ∧ (k10PairEntry i).first ≤ 9 / 4 ∧
    123 / 100 ≤ (k10PairEntry i).second ∧ (k10PairEntry i).second ≤ 9 / 4 ∧
    scalarAngleCheck (k10PairEntry i).first (k10PairEntry i).second
      (k10PairEntry i).units 100000 = true := by
  decide +kernel

theorem k10_gamma_entry_lower (i : Fin 79) (b r : ℝ)
    (hb : 3 < b) (hbB : b ≤ 3521357 / 1000000)
    (hr : (k10GammaEntry i).radius ≤ r) (hru : r ≤ 9 / 4) :
    ((k10GammaEntry i).units : ℝ) / 100000 ≤ contactAngle b r := by
  have hd := k10_gamma_entries_checked i
  have hl : (0 : ℝ) < (k10GammaEntry i).radius := by exact_mod_cast hd.1
  have hh := scalarAngleCheck_sound (3521357 / 1000000) (k10GammaEntry i).radius
    (k10GammaEntry i).units 100000 hd.2.2 (by norm_num)
  have hm := contactAngle_outer_lower_corner b (3521357 / 1000000)
    (k10GammaEntry i).radius r hb hbB (by norm_num) hl hr (by linarith)
  norm_num only [Rat.cast_div, Rat.cast_ofNat] at hh
  exact hh.trans hm

theorem k10_pair_entry_lower (i : Fin 736) (r s : ℝ)
    (hr : (123 / 100 : ℝ) ≤ r) (hs : (123 / 100 : ℝ) ≤ s)
    (hru : r ≤ (k10PairEntry i).first) (hsu : s ≤ (k10PairEntry i).second) :
    ((k10PairEntry i).units : ℝ) / 100000 ≤ contactAngle r s := by
  have hd := k10_pair_entries_checked i
  have hR0 : ((k10PairEntry i).first : ℝ) ≤ ((9 / 4 : ℚ) : ℝ) := by exact_mod_cast hd.2.1
  have hS0 : ((k10PairEntry i).second : ℝ) ≤ ((9 / 4 : ℚ) : ℝ) := by exact_mod_cast hd.2.2.2.1
  have hR : ((k10PairEntry i).first : ℝ) ≤ 9 / 4 := by simpa using hR0
  have hS : ((k10PairEntry i).second : ℝ) ≤ 9 / 4 := by simpa using hS0
  have hh := scalarAngleCheck_sound (k10PairEntry i).first (k10PairEntry i).second
    (k10PairEntry i).units 100000 hd.2.2.2.2 (by norm_num)
  exact hh.trans (contactAngle_pair_upper_corner r (k10PairEntry i).first
    s (k10PairEntry i).second hr hru hR hs hsu hS)

